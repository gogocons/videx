#!/usr/bin/env bash

usage() {
  cat <<'EOF'
Usage: ./videx COMMAND [ARGUMENTS ...]

Save and organize YouTube bookmarks in a searchable offline library.

  open        Open the existing library index
  capture     Save or refresh a video bookmark
  import      Preview or apply a TXT or public playlist import
  index       Rebuild the offline library index
  find        Look up a video or audit the library
  tag         Inspect or edit personal tags
  collection  Inspect or edit local Collections
  upgrade     Preview or apply offline bookmark upgrades

Run ./videx COMMAND --help for command options.
Commands use the library in config.local.json, or the Videx project directory
if the file is absent. See each command's help for its library override.

To turn a playlist into a Collection, see ./videx import --help for the
full workflow and ./videx collection from-import --help for review and apply.
EOF
}

case ${1-} in
  -h|--help) usage; exit 0 ;;
esac
if (( $# == 0 )); then
  usage >&2
  exit 2
fi

case $1 in
  capture|open|import|index|find|tag|collection|upgrade) ;;
  *) printf 'videx: unknown command: %s\n' "$1" >&2; exit 2 ;;
esac

dispatch() {
  # Use positional parameters so caller environment variables are inherited.
  if [[ $2 = capture ]]; then
    exec bash "${1%/*}/scripts/yt-bookmark.sh" "${@:3}"
  fi
  exec python3 -B "${1%/*}/scripts/yt-bookmark-$2.py" "${@:3}"
}

case ${BASH_SOURCE[0]} in
  /*) dispatch "${BASH_SOURCE[0]}" "$@" ;;
  *) dispatch "$PWD/${BASH_SOURCE[0]}" "$@" ;;
esac
